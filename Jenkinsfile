pipeline {
  agent any
  stages {
        stage ("checkOut") {
      steps {
        echo 'checkOut application'
      }
    }
    stage ("build") {
      steps {
        echo 'building application 123'
      }
    }
        stage ("test") {
      steps {
        echo 'test application'
      }
    }
        stage ("deploy") {
      steps {
        echo 'deploy application'
      }
    }
            stage ("cleanUp") {
      steps {
        echo 'cleanUP application'
      }
    }
  }
}
